# Frontend build-time env (Vite). Copy to `.env` (or set in the Cloudflare Pages
# build settings) for the Cloudflare deployment. The GitHub Pages / offline build
# leaves ALL of these unset, which keeps the app fully guest/local (no login, no
# cloud sync) — see docs/deployment-cloudflare.md.

# Same-origin API base for the Cloudflare build. Setting this is what turns on
# accounts + cloud sync (`hasBackend()`). Use `/api` for same-origin Pages
# Functions, or a full origin (https://api.example.com) for a cross-origin API.
VITE_API_BASE=/api

# Cloudflare deploys at the site root (GitHub Pages uses /sofa-so-good/).
VITE_BASE=/

# Cloudflare Turnstile site key for the login form (paired with the
# TURNSTILE_SECRET Worker secret). Leave unset to disable the CAPTCHA (dev).
VITE_TURNSTILE_SITE_KEY=
