{
  "entry": [
    "scripts/**/*.{mjs,ts}",
    "**/*.test.{ts,tsx}",
    "functions/**/*.ts",
    "workers/**/*.ts",
    "electron/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "functions/**/*.ts", "workers/**/*.ts", "electron/*.mjs"],
  "ignore": [
    // Python-adjacent GLB optimisation helpers — invoke external CLIs (toktx from
    // KTX-Software, an optional guarded `import('@gltf-transform/cli')`) that are not
    // part of the TS build graph; not npm-managed, so leave them out of knip's analysis.
    "python/**"
  ],
  // Dev-probes reach into the app with `await import('/src/...')` from INSIDE
  // `page.evaluate` — a Vite dev-server URL resolved by the browser at runtime,
  // not a Node import resolved from disk. Knip parses the specifier statically
  // and cannot follow it, so every one reads as unresolved. The probes are
  // dev-only instruments (`scripts/dev-probes/`, run against `npm run dev`);
  // a broken specifier there fails the probe loudly on its next run.
  "ignoreUnresolved": ["^/src/"],
  "ignoreDependencies": [
    // Playwright is the driver for the screenshot/scenario harness (scripts/shot.mjs),
    // launched via node, so knip's import graph never sees it — keep it declared, don't uninstall.
    "@playwright/test",
    "playwright",
    // wrangler is the Cloudflare deploy CLI used from deployment docs/CI, not imported in code.
    "wrangler"
  ],
  "ignoreBinaries": [
    // macOS system binary, shelled out to by scripts/chrome-focus.mjs to raise the
    // Chrome window before a visual check. Nothing to install.
    "osascript"
  ],
  "vite": {
    "config": ["vite.config.ts"]
  },
  "vitest": {
    "config": ["vitest.config.ts"]
  },
  "rules": {
    "files": "error",
    "unresolved": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "enumMembers": "error"
  }
}
