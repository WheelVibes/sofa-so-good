{
  "name": "clearance-checks-simple",
  "description": "IXT-SUITES: clearanceChecks (pro) flag gate + panel/overlay. Hidden in Simple, present in Pro; the panel mounts (#clearancePanel) with the walkway summary and the in-scene clearance overlay toggles. Mobile-viewport parity leg.",
  "url": "http://localhost:5208/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "dismiss-overlays", "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.()" },
    { "name": "set-daytime", "eval": "window.__store.getState().setManualHour?.(13)" },
    { "name": "assert-simple-hidden", "waitFor": { "store": "state.uiMode === 'simple' && state.featureFlags.clearanceChecks === false" }, "timeout": 5000, "failMessage": "clearanceChecks should be OFF in Simple mode" },
    { "name": "to-pro", "eval": "(()=>{const s=window.__store.getState(); s.setUiMode('pro'); s.reresolveFeatureFlags();})()" },
    { "name": "assert-pro-on", "waitFor": { "store": "state.featureFlags.clearanceChecks === true" }, "timeout": 5000, "failMessage": "clearanceChecks should be ON in Pro mode" },
    { "name": "open-panel", "store": { "action": "setClearancePanelOpen", "args": [true] } },
    { "name": "panel-visible", "waitFor": { "css": "#clearancePanel" }, "timeout": 8000, "failMessage": "Clearance panel (#clearancePanel) did not mount" },
    { "name": "assert-title", "waitFor": { "text": "Clearance checks" }, "timeout": 5000 },
    { "name": "shot-panel", "screenshot": "clearance-panel" },
    { "name": "overlay-on", "store": { "action": "toggleClearance", "args": [] } },
    { "name": "assert-overlay", "waitFor": { "store": "state.clearanceOn === true" }, "timeout": 5000 },
    { "name": "settle-overlay", "wait": 1200 },
    { "name": "shot-overlay", "screenshot": "clearance-overlay" },
    { "name": "mobile", "viewport": { "width": 390, "height": 844 } },
    { "name": "settle-mobile", "wait": 1000 },
    { "name": "shot-mobile", "screenshot": "clearance-mobile" },
    { "name": "close-panel", "store": { "action": "setClearancePanelOpen", "args": [false] } },
    { "name": "panel-gone", "waitFor": { "css": "#clearancePanel", "visible": false }, "timeout": 5000 },
    { "name": "back-to-simple", "eval": "(()=>{const s=window.__store.getState(); s.setUiMode('simple'); s.reresolveFeatureFlags();})()" },
    { "name": "assert-simple-again", "waitFor": { "store": "state.featureFlags.clearanceChecks === false" }, "timeout": 5000 }
  ]
}
