  { "name":"w2","wait":140 },
  { "name":"upp","eval":"(()=>{document.querySelector('.plan-paper').dispatchEvent(new PointerEvent('pointerup',{clientX:window.__x0,clientY:window.__y0+280,bubbles:true,pointerId:1}));})()" },
  { "name":"w3","wait":400 },
  { "name":"rec","eval":"(()=>{const s=window.__store.getState();const eff=(it)=>{const p=it.props.scale;if(typeof p==='number')return p;const d=s.floorPlan;return 1;};const a=s.items.find(i=>i.id===window.__a),b=s.items.find(i=>i.id===window.__b);window.__sa0=typeof a.props.scale==='number'?a.props.scale:1;window.__sb0=typeof b.props.scale==='number'?b.props.scale:1;window.__d0=Math.hypot(a.position[0]-b.position[0],a.position[1]-b.position[1]);})()" },
  { "name":"hdn","eval":"(()=>{const rects=[...document.querySelectorAll('rect')].filter(r=>(r.getAttribute('style')||'').includes('resize'));const se=rects.map(r=>({r,b:r.getBoundingClientRect()})).sort((p,q)=>(q.b.x+q.b.y)-(p.b.x+p.b.y))[0];window.__hx=se.b.x+se.b.width/2;window.__hy=se.b.y+se.b.height/2;se.r.dispatchEvent(new PointerEvent('pointerdown',{clientX:window.__hx,clientY:window.__hy,bubbles:true,pointerId:1,button:0}));console.log('HANDLES='+rects.length+' SE='+Math.round(window.__hx)+','+Math.round(window.__hy));})()" },
  { "name":"h1","wait":140 },
  { "name":"hmv","eval":"(()=>{document.querySelector('.plan-paper').dispatchEvent(new PointerEvent('pointermove',{clientX:window.__hx+40,clientY:window.__hy+40,bubbles:true,pointerId:1}));})()" },
  { "name":"h2","wait":140 },
  { "name":"hmv2","eval":"(()=>{document.querySelector('.plan-paper').dispatchEvent(new PointerEvent('pointermove',{clientX:window.__hx+80,clientY:window.__hy+80,bubbles:true,pointerId:1}));})()" },
  { "name":"h3","wait":140 },
  { "name":"hup","eval":"(()=>{document.querySelector('.plan-paper').dispatchEvent(new PointerEvent('pointerup',{clientX:window.__hx+80,clientY:window.__hy+80,bubbles:true,pointerId:1}));})()" },
  { "name":"h4","wait":300 },
  { "name":"probe","eval":"(()=>{const s=window.__store.getState();const a=s.items.find(i=>i.id===window.__a),b=s.items.find(i=>i.id===window.__b);const sa=typeof a.props.scale==='number'?a.props.scale:1;const sb=typeof b.props.scale==='number'?b.props.scale:1;const fA=+(sa/window.__sa0).toFixed(3),fB=+(sb/window.__sb0).toFixed(3);const d1=Math.hypot(a.position[0]-b.position[0],a.position[1]-b.position[1]);const fPos=+(d1/window.__d0).toFixed(3);console.log('PROBE fA='+fA+' fB='+fB+' fPos='+fPos+' equalScale='+(fA===fB)+' grew='+(fA>1.001)+' posMatchesScale='+(Math.abs(fPos-fA)<0.05));})()" },
