{
  "name": "ies-lights-simple",
  "url": "http://localhost:5174/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    {
      "name": "dismiss-overlays",
      "eval": "(()=>{const s=window.__store.getState();s.endTour&&s.endTour();s.setOnboardingOpen&&s.setOnboardingOpen(false);s.dismissLocationPrompt&&s.dismissLocationPrompt();localStorage.setItem('hdb_onboarded','1')})()"
    },
    { "name": "pro-mode", "store": { "action": "setUiMode", "args": ["pro"] } },
    { "name": "night", "store": { "action": "setManualHour", "args": [22] } },
    { "name": "lights-on", "store": { "action": "setLightsMode", "args": ["on"] } },
    {
      "name": "keep-living-emitters",
      "eval": "(()=>{const s=window.__store.getState();const keep=s.items.filter(i=>['default-main-pendant','default-main-tablelamp','default-main-lamp'].includes(i.id)||(i.position[0]<3.2&&i.position[1]<3.8&&i.position[1]>0.2));s.setItems(keep)})()"
    },
    { "name": "settle-omni", "wait": 2000 },
    { "name": "zoom-in", "wheel": { "x": 800, "y": 500, "dy": -260 } },
    { "name": "settle-view", "wait": 1500 },
    { "name": "shot-omni", "screenshot": "omni-glow" },
    {
      "name": "apply-ies-narrow",
      "eval": "(()=>{const s=window.__store.getState();for(const i of s.items){if(i.defId==='ceiling-light')s.updateItemProps(i.id,{iesProfile:'narrow-downlight'})}})()"
    },
    { "name": "nudge-render", "eval": "(()=>{window.__store.getState().setManualHour(22.0)})()" },
    { "name": "settle-ies", "wait": 2000 },
    { "name": "shot-ies-narrow", "screenshot": "ies-narrow" },
    {
      "name": "apply-ies-wide",
      "eval": "(()=>{const s=window.__store.getState();for(const i of s.items){if(i.defId==='ceiling-light')s.updateItemProps(i.id,{iesProfile:'wide-downlight'})}})()"
    },
    { "name": "nudge-render-2", "eval": "(()=>{window.__store.getState().setManualHour(22.0)})()" },
    { "name": "settle-ies-wide", "wait": 2000 },
    { "name": "shot-ies-wide", "screenshot": "ies-wide" }
  ]
}
