{
  "name": "registry-tools-verify",
  "url": "http://localhost:5174/",
  "steps": [
    { "name": "tall-viewport", "viewport": { "width": 1100, "height": 1300 } },
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "boot-splash-gone", "waitFor": { "css": "#boot-loader", "visible": false }, "timeout": 60000, "failMessage": "#boot-loader still covering the screen. It is removed from the DOM only once `booting` clears, which depends on sceneReady \u2014 measured 751ms and 36604ms across two runs of the SAME scenario, so no fixed wait covers it. Every screenshot before this point is the loader, and nothing fails (v0.31.9.6)." },
    { "name": "dismiss-overlays", "eval": "(() => { const s=window.__store.getState(); localStorage.setItem('hdb_onboarded','1'); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.(); })()" },
    { "name": "scene-ready", "store": { "action": "setSceneReady", "args": [true] } },
    { "name": "pro-mode", "store": { "action": "setUiMode", "args": ["pro"] } },
    { "name": "reresolve-flags", "eval": "window.__store.getState().reresolveFeatureFlags()" },
    { "name": "open-tools", "click": "button[aria-label=\"Tools\"]" },
    { "name": "tools-open", "waitFor": { "css": ".menu-item" }, "timeout": 8000 },
    { "name": "shot-tools", "screenshot": "registry-tools-menu" },
    { "name": "close-tools", "eval": "document.body.click()" },
    { "name": "open-cmdk", "store": { "action": "setCmdkOpen", "args": [true] } },
    { "name": "cmdk-open", "waitFor": { "css": ".cmdk-item" }, "timeout": 8000 },
    { "name": "shot-cmdk", "screenshot": "registry-cmdk" }
  ]
}
