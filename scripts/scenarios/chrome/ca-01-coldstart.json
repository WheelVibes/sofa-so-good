{
  "name": "ca-01-coldstart",
  "description": "Audit pass 1 — first-run cold start in a real Chrome tab: onboarding carousel (3 steps), the 5 start choices, guided tour, location prompt, first paint of the move-in default flat. Host clears localStorage + reloads BEFORE loading this scenario.",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 30000 },
    { "name": "onboarding-open", "waitFor": { "store": "state.onboardingOpen === true" }, "timeout": 30000 },
    { "name": "onb-card-mounted", "waitFor": { "css": ".onb-card" }, "timeout": 5000 },

    { "name": "probe-onb-at-open", "probe": { "checks": ["transparent"], "scope": ".onb-card" } },
    { "name": "shot-onboarding-welcome", "screenshot": "01-onboarding-welcome" },
    { "name": "probe-onboarding", "probe": { "checks": ["overflow", "clipped", "naming", "covered", "contrast"], "scope": ".onb-overlay" } },

    { "name": "click-get-started", "click": { "text": "Get started" } },
    { "name": "onb-step2", "waitFor": { "css": ".onb-body2" }, "timeout": 5000 },
    { "name": "shot-onboarding-tour-preview", "screenshot": "02-onboarding-quick-tour" },

    { "name": "click-next", "click": { "text": "Next" } },
    { "name": "onb-step3", "waitFor": { "css": ".onb-body3" }, "timeout": 5000 },
    { "name": "shot-onboarding-choices", "screenshot": "03-onboarding-start-choices" },
    { "name": "probe-choices", "probe": { "checks": ["clipped", "naming", "tapTargets", "contrast"], "scope": ".onb-choices" } },
    { "name": "assert-five-choices", "assert": { "js": "document.querySelectorAll('.onb-choice').length === 5", "message": "expected 5 start choices (tour/smart/catalog/demo/empty)" } },

    { "name": "click-guided-tour", "click": { "text": "Take the guided tour" } },
    { "name": "onboarding-closed", "waitFor": { "store": "state.onboardingOpen === false" }, "timeout": 5000 },
    { "name": "tour-open", "waitFor": { "store": "state.tourOpen === true" }, "timeout": 10000 },
    { "name": "shot-tour-step1", "screenshot": "04-tour-step1" },
    { "name": "probe-tour", "probe": { "checks": ["overflow", "clipped", "covered", "contrast"] } },

    { "name": "tour-next-1", "click": { "text": "Next" } },
    { "name": "tour-step2", "waitFor": { "store": "state.tourStep === 1" }, "timeout": 5000 },
    { "name": "shot-tour-step2", "screenshot": "05-tour-step2" },
    { "name": "tour-next-2", "click": { "text": "Next" } },
    { "name": "tour-step3", "waitFor": { "store": "state.tourStep === 2" }, "timeout": 5000 },
    { "name": "shot-tour-step3", "screenshot": "06-tour-step3" },

    { "name": "end-tour", "store": { "action": "endTour", "args": [] } },
    { "name": "tour-closed", "waitFor": { "store": "state.tourOpen === false" }, "timeout": 5000 },

    { "name": "settle-first-paint", "wait": 2000 },
    { "name": "shot-first-paint", "screenshot": "07-first-paint-move-in-default" },
    { "name": "probe-first-paint", "probe": { "checks": ["console", "overflow", "clipped", "naming", "covered", "assets", "ids"] } }
  ]
}
