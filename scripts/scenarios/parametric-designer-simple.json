{
  "name": "parametric-designer-simple",
  "description": "IXT-SUITES: custom-size (parametric) furniture designer (pro). Hidden in Simple, present in Pro; the dialog mounts with type tabs + a live 3D preview; switching type (Bookshelf → Wardrobe) updates the preview; closes cleanly.",
  "url": "http://localhost:5208/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "dismiss-overlays", "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.()" },
    { "name": "set-daytime", "eval": "window.__store.getState().setManualHour?.(13)" },
    { "name": "assert-simple-hidden", "waitFor": { "store": "state.uiMode === 'simple' && state.featureFlags.parametricFurniture === false" }, "timeout": 5000, "failMessage": "parametricFurniture should be OFF in Simple mode" },
    { "name": "to-pro", "eval": "(()=>{const s=window.__store.getState(); s.setUiMode('pro'); s.reresolveFeatureFlags();})()" },
    { "name": "assert-pro-on", "waitFor": { "store": "state.featureFlags.parametricFurniture === true" }, "timeout": 5000, "failMessage": "parametricFurniture should be ON in Pro mode" },
    { "name": "open-dialog", "store": { "action": "setParametricOpen", "args": [true] } },
    { "name": "dialog-visible", "waitFor": { "css": ".parametric-dialog" }, "timeout": 8000, "failMessage": "Parametric dialog did not mount" },
    { "name": "assert-title", "waitFor": { "text": "Custom-size furniture" }, "timeout": 5000 },
    { "name": "settle-preview", "wait": 2000 },
    { "name": "shot-bookshelf", "screenshot": "parametric-bookshelf" },
    { "name": "switch-wardrobe", "click": { "text": "Wardrobe" } },
    { "name": "settle-wardrobe", "wait": 2000 },
    { "name": "shot-wardrobe", "screenshot": "parametric-wardrobe" },
    { "name": "close", "store": { "action": "setParametricOpen", "args": [false] } },
    { "name": "dialog-gone", "waitFor": { "css": ".parametric-dialog", "visible": false }, "timeout": 5000 },
    { "name": "back-to-simple", "eval": "(()=>{const s=window.__store.getState(); s.setUiMode('simple'); s.reresolveFeatureFlags();})()" },
    { "name": "assert-simple-again", "waitFor": { "store": "state.featureFlags.parametricFurniture === false" }, "timeout": 5000 }
  ]
}
