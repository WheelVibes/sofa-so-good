{
  "name": "first-run-mobile-tour",
  "description": "Mobile viewport: clean profile boot → onboarding carousel → choose 'Take the guided tour' → assert the tour OPENS and shows its centred-card walkthrough (it must NOT flash open and die into the location prompt) → step through → skip → location prompt appears LAST → furnished scene. Regression for the mobile tour/location-modal ordering bug.",
  "url": "http://localhost:5212/",
  "steps": [
    {
      "name": "mobile-viewport",
      "viewport": { "width": 390, "height": 844 }
    },
    {
      "name": "clear-storage",
      "eval": "try { localStorage.clear() } catch {}"
    },
    {
      "name": "reload-clean",
      "eval": "location.reload()"
    },
    {
      "name": "store-ready",
      "waitFor": { "storeExists": true },
      "timeout": 60000
    },
    {
      "name": "onboarding-open",
      "waitFor": { "store": "state.onboardingOpen === true" },
      "timeout": 60000
    },
    {
      "name": "click-get-started",
      "click": { "text": "Get started" }
    },
    {
      "name": "onboarding-step2-visible",
      "waitFor": { "css": ".onb-body2" },
      "timeout": 5000
    },
    {
      "name": "click-next",
      "click": { "text": "Next" }
    },
    {
      "name": "onboarding-step3-visible",
      "waitFor": { "css": ".onb-body3" },
      "timeout": 5000
    },
    {
      "name": "shot-onboarding-choices",
      "screenshot": "onboarding-step3-choices"
    },
    {
      "name": "click-guided-tour",
      "click": { "text": "Take the guided tour" }
    },
    {
      "name": "onboarding-closed",
      "waitFor": { "store": "state.onboardingOpen === false" },
      "timeout": 5000
    },
    {
      "name": "tour-open",
      "waitFor": { "store": "state.tourOpen === true" },
      "timeout": 8000
    },
    {
      "name": "tour-card-visible",
      "waitFor": { "css": ".tour-root" },
      "timeout": 5000
    },
    {
      "name": "shot-tour-step1",
      "screenshot": "mobile-tour-step1-welcome"
    },
    {
      "name": "assert-location-suppressed-during-tour",
      "eval": "if (window.__store.getState().tourOpen !== true) throw new Error('tour closed unexpectedly')"
    },
    {
      "name": "tour-next-1",
      "click": { "text": "Next" }
    },
    {
      "name": "tour-step2-wait",
      "waitFor": { "store": "state.tourStep === 1" },
      "timeout": 5000
    },
    {
      "name": "shot-tour-step2",
      "screenshot": "mobile-tour-step2-look-around"
    },
    {
      "name": "skip-tour",
      "click": { "text": "Skip tour" }
    },
    {
      "name": "tour-closed",
      "waitFor": { "store": "state.tourOpen === false" },
      "timeout": 5000
    },
    {
      "name": "location-prompt-visible",
      "waitFor": { "css": ".modal-overlay" },
      "timeout": 8000
    },
    {
      "name": "shot-location-prompt",
      "screenshot": "mobile-location-prompt-last"
    },
    {
      "name": "dismiss-location",
      "click": { "text": "Skip — use default location" }
    },
    {
      "name": "location-dismissed",
      "waitFor": { "css": ".modal-overlay", "visible": false },
      "timeout": 5000
    },
    {
      "name": "settle",
      "wait": 1500
    },
    {
      "name": "shot-final-scene",
      "screenshot": "mobile-final-scene"
    }
  ]
}
