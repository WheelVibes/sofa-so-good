    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "dismiss-overlays", "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.()" },
    { "name": "daytime", "eval": "window.__store.getState().setManualHour?.(13)" },
    { "name": "helpers", "eval": "window.__place=(defId,props)=>window.__store.getState().setItems([{id:'AUD',defId,position:[10.0,3.6],rotation:0,props:props||{}}]); window.__camLow=()=>{const t=window.__three,c=t.controls;t.camera.position.set(12.6,1.05,6.2);if(c){c.target.set(10.0,0.4,3.6);c.update();}t.camera.lookAt(10.0,0.4,3.6);}; window.__camTall=()=>{const t=window.__three,c=t.controls;t.camera.position.set(13.0,1.85,6.6);if(c){c.target.set(10.0,1.0,3.6);c.update();}t.camera.lookAt(10.0,1.0,3.6);}; true" },

    { "name": "p-bed-single", "eval": "window.__place('bed-single',{}); window.__camLow()" },
    { "name": "w-bed-single", "wait": 1500 },
    { "name": "s-bed-single", "screenshot": "bed-single" },

