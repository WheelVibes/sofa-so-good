{
  "name": "photo-pom-ab",
  "description": "PHOTO-POM A/B: white-tile living floor viewed in walk mode at a grazing pitch (High tier), shot with the pomFloors flag OFF (normal-map only) then ON (parallax-occlusion). Grout should visibly recess/occlude between the two at the grazing floor band. Plus a Medium-tier pair proving POM is inert below High.",
  "url": "http://localhost:5231/",
  "steps": [
    {
      "name": "store-ready",
      "waitFor": {
        "storeExists": true
      },
      "timeout": 60000
    },
    { "name": "boot-splash-gone", "waitFor": { "css": "#boot-loader", "visible": false }, "timeout": 60000, "failMessage": "#boot-loader still covering the screen. It is removed from the DOM only once `booting` clears, which depends on sceneReady \u2014 measured 751ms and 36604ms across two runs of the SAME scenario, so no fixed wait covers it. Every screenshot before this point is the loader, and nothing fails (v0.31.9.6)." },
    {
      "name": "dismiss-overlays",
      "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.()"
    },
    {
      "name": "scene-ready",
      "waitFor": {
        "store": "state.sceneReady === true"
      },
      "timeout": 90000
    },
    {
      "name": "set-daytime",
      "eval": "window.__store.getState().setManualHour?.(13)"
    },
    {
      "name": "open-curtains",
      "eval": "(function(){ const s=window.__store.getState(); s.items.filter(i=>i.defId==='curtains').forEach(i=>s.updateItemProps(i.id,{drawAmount:0})); })()"
    },
    {
      "name": "tile-floor",
      "eval": "window.__store.getState().setFloorFinish('livingDining','floor-tile-white')"
    },
    {
      "name": "tier-high",
      "store": {
        "action": "setQualityTier",
        "args": [
          "high"
        ]
      }
    },
    {
      "name": "settle-tier",
      "wait": 2500
    },
    {
      "name": "hide-loading",
      "eval": "window.__store.getState().hideLoading?.()"
    },
    {
      "name": "enter-walk",
      "store": {
        "action": "setCameraMode",
        "args": [
          "firstPerson"
        ]
      }
    },
    {
      "name": "enter-walk-overlay-shown",
      "waitFor": {
        "css": "[data-transition-overlay]"
      },
      "timeout": 12000,
      "failMessage": "'Entering walkthrough' splash never appeared, so the gone-wait below would pass vacuously. If this transition genuinely raises no splash (same mode, or the room editor owns the overlay) delete BOTH guard steps rather than widening the timeout."
    },
    {
      "name": "enter-walk-overlay-gone",
      "waitFor": {
        "css": "[data-transition-overlay]",
        "visible": false
      },
      "timeout": 60000,
      "failMessage": "'Entering walkthrough' splash still up; the next screenshot would capture the splash, not the scene. See docs/visual-verification-playbook.md."
    },
    {
      "name": "walk-ready",
      "waitFor": {
        "store": "state.cameraMode === 'firstPerson'"
      },
      "timeout": 20000
    },
    {
      "name": "dismiss-walk-callout",
      "eval": "window.__store.getState().dismissCallout?.('walk-mode')"
    },
    {
      "name": "low-eye",
      "eval": "window.__store.getState().setWalkEyeHeight?.(1.35)"
    },
    {
      "name": "settle-walk",
      "wait": 1800
    },
    {
      "name": "pitch-down",
      "eval": "window.__walkLook && window.__walkLook.setPitch(-0.62)"
    },
    {
      "name": "settle-pitch",
      "wait": 1400
    },
    {
      "name": "pom-off",
      "eval": "window.__store.getState().setFeatureFlag('pomFloors', false)"
    },
    {
      "name": "settle-off",
      "wait": 1400
    },
    {
      "name": "shot-high-pomoff",
      "screenshot": "high-pomoff"
    },
    {
      "name": "pom-on",
      "eval": "window.__store.getState().setFeatureFlag('pomFloors', true)"
    },
    {
      "name": "settle-on",
      "wait": 1600
    },
    {
      "name": "shot-high-pomon",
      "screenshot": "high-pomon"
    },
    {
      "name": "tier-medium",
      "store": {
        "action": "setQualityTier",
        "args": [
          "medium"
        ]
      }
    },
    {
      "name": "settle-med",
      "wait": 3000
    },
    {
      "name": "hide-loading-med",
      "eval": "window.__store.getState().hideLoading?.()"
    },
    {
      "name": "repitch-med",
      "eval": "window.__walkLook && window.__walkLook.setPitch(-0.62)"
    },
    {
      "name": "med-pom-off",
      "eval": "window.__store.getState().setFeatureFlag('pomFloors', false)"
    },
    {
      "name": "settle-medoff",
      "wait": 1400
    },
    {
      "name": "shot-med-pomoff",
      "screenshot": "medium-pomoff"
    },
    {
      "name": "med-pom-on",
      "eval": "window.__store.getState().setFeatureFlag('pomFloors', true)"
    },
    {
      "name": "settle-medon",
      "wait": 1400
    },
    {
      "name": "shot-med-pomon",
      "screenshot": "medium-pomon"
    },
    {
      "name": "reset-flags",
      "eval": "window.__store.getState().resetFeatureFlags()"
    }
  ]
}