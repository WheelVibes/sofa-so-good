{
  "name": "wall-reveal-sweep",
  "description": "WALL-REVEAL pop repro (orbit/dollhouse, 20:00, lights on, realistic tier, deviceClass pinned capable per the playbook gotcha). Orbits the azimuth around the boot pose in 36 x 10 deg steps and, after a 700 ms settle, probes every wall segment reveal opacity via the DEV-only window.__wallOpacities(), dumping the whole trace as one console.log at the end (shot.mjs prints the last 30 console lines). Used to show that the per-wall opacity is a smooth function of the camera azimuth, and that the several WallDefs making up ONE physical wall (wall-ext-E-col1/-col2/-mid, wall-int-b3-LD/-col) now settle at IDENTICAL opacities (WALL-REVEAL-RUN-SHARED) instead of diverging by up to 0.12. Edit the k*10 step to 0.5 for a fine sweep.",
  "url": "http://localhost:5200/",
  "steps": [
    {
      "name": "store-ready",
      "waitFor": {
        "storeExists": true
      },
      "timeout": 60000
    },
    {
      "name": "boot-splash-gone",
      "waitFor": {
        "css": "#boot-loader",
        "visible": false
      },
      "timeout": 60000
    },
    {
      "name": "setup",
      "eval": "(() => { try { localStorage.setItem('hdb_onboarded','1') } catch {}; const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.(); s.dismissChecklist?.(); s.setTimeMode?.('manual'); s.setManualHour?.(20); s.setLightsMode?.('on'); s.setQualityTier?.('realistic'); s.setCameraMode?.('orbit'); s.setFeatureFlag?.('interactiveDegrade', false); s.hideLoading?.() })()"
    },
    {
      "name": "scene-ready",
      "waitFor": {
        "store": "state.sceneReady === true"
      },
      "timeout": 120000
    },
    {
      "name": "pin-device-class",
      "eval": "(() => { const s = window.__store; s.getState().setDeviceClass('capable'); s.setState({ setDeviceClass: () => {} }) })()"
    },
    {
      "name": "hide-chrome",
      "eval": "(()=>{for(const sel of ['.gs-panel','.checklist','[class*=\"get-started\"]']){document.querySelectorAll(sel).forEach(e=>{e.style.display='none'})}})()"
    },
    {
      "name": "settle-boot",
      "wait": 5000
    },
    {
      "name": "sweep-init",
      "eval": "(() => {\n  const W = window;\n  const t = W.__three;\n  const cam = t.camera, c = t.controls;\n  const V = cam.position.constructor;\n  const tgt = c ? c.target : { x: 0, y: 0, z: 0 };\n  const dx = cam.position.x - tgt.x, dy = cam.position.y - tgt.y, dz = cam.position.z - tgt.z;\n  const R = Math.hypot(dx, dy, dz);\n  const el = Math.asin(dy / R);\n  const az0 = Math.atan2(dx, dz);\n  // Pull the dollhouse IN so ONE wall fills a large screen area: the reveal is\n  // orientation-only (zoom never changes the fade), so this changes nothing about\n  // the opacities while making a fixed screen patch stay on the same wall across\n  // the whole 5.5 deg sweep instead of sliding off it.\n  W.__sweep = {\n    R: 10, el, az0, tx: tgt.x, ty: tgt.y, tz: tgt.z,\n    log: [],\n    boot: { azDeg: (az0 * 180) / Math.PI, elDeg: (el * 180) / Math.PI, R },\n    set(azDeg) {\n      const a = (azDeg * Math.PI) / 180;\n      cam.position.set(\n        this.tx + this.R * Math.cos(this.el) * Math.sin(a),\n        this.ty + this.R * Math.sin(this.el),\n        this.tz + this.R * Math.cos(this.el) * Math.cos(a),\n      );\n      if (c) { c.update(); } else { cam.lookAt(this.tx, this.ty, this.tz); }\n      W.__store.getState().invalidate?.();\n    },\n    probe(tag, azDeg) {\n      const fwd = cam.getWorldDirection(new V());\n      const ops = W.__wallOpacities ? W.__wallOpacities() : {};\n      const ids = Object.keys(ops).sort();\n      const parts = ids.map((k) => `${k}=${ops[k].toFixed(3)}`);\n      this.log.push(`SWEEP ${tag} az=${azDeg.toFixed(2)} fwd=(${fwd.x.toFixed(3)},${fwd.y.toFixed(3)},${fwd.z.toFixed(3)}) ${parts.join(' ')}`);\n    },\n    dump() { console.log('===SWEEPLOG===\\n' + this.log.join('\\n') + '\\n===ENDSWEEP==='); },\n  };\n  console.log('SWEEP-BOOT ' + JSON.stringify(W.__sweep.boot) + ' target=' + JSON.stringify({ x: tgt.x, y: tgt.y, z: tgt.z }));\n})()\n"
    },
    {
      "name": "coarse-set-0",
      "eval": "window.__sweep.set(window.__sweep.boot.azDeg + 0)"
    },
    {
      "name": "coarse-wait-0",
      "wait": 700
    },
    {
      "name": "coarse-probe-0",
      "eval": "window.__sweep.probe('coarse', window.__sweep.boot.azDeg + 0)"
    },
