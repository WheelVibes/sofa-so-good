{
  "name": "expansion-e2a",
  "description": "Expansion wave E2A audit — two NEW Tier-2 primitives: sofa-bed (sofa mode with fold-line + storage drawer / fold-out bed mode with mid fold seam + retained arms) and display-cabinet vitrine (full-glass / glass+base half / compact wall-mounted / lit warm-glow). Whole-flat ORBIT (dollhouse) camera at High tier under SHOT_GPU so glass + fabric + the emissive lit strip read truthfully; every requestFrameSelection closeup inherits the ~3/4 elevation that reveals float/attachment. Includes a bed-mode fold-seam closeup and a lit-vitrine night frame.",
  "url": "http://localhost:5301/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "boot-splash-gone", "waitFor": { "css": "#boot-loader", "visible": false }, "timeout": 60000, "failMessage": "#boot-loader still covering the screen. It is removed from the DOM only once `booting` clears, which depends on sceneReady \u2014 measured 751ms and 36604ms across two runs of the SAME scenario, so no fixed wait covers it. Every screenshot before this point is the loader, and nothing fails (v0.31.9.6)." },
    {
      "name": "dismiss-overlays",
      "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.()"
    },
    { "name": "set-daytime", "eval": "window.__store.getState().setManualHour?.(13)" },
    { "name": "set-high-tier", "eval": "window.__store.getState().setQualityTier?.('high')" },
    { "name": "ensure-orbit", "eval": "(function(){ const s = window.__store.getState(); s.exitRoomEditor?.(); s.setCameraMode?.('orbit'); })()" },
    { "name": "wait-orbit", "wait": 2000 },
    { "name": "clear-items", "store": { "action": "setItems", "args": [[]] } },
    { "name": "wait-clear", "wait": 800 },
    {
      "name": "compute-anchors",
      "eval": "(function(){ const st = window.__store.getState(); const fp = st.floorPlan; const room = fp.rooms.find(r => r.id === 'livingDining') || fp.rooms[0]; if (!room) throw new Error('no room'); const ox = room.origin[0], oz = room.origin[1], W = room.width, D = room.depth; window.__room = { ox, oz, W, D, cx: ox + W/2, cz: oz + D/2 }; console.log('room', JSON.stringify(window.__room)); })()"
    },

    { "name": "grid-all", "eval": "(function(){ const r = window.__room; const items=[ {id:'g-sofa',defId:'sofa-bed',position:[r.cx-1.3,r.cz-1.0],rotation:0,props:{mode:'sofa'}}, {id:'g-bed',defId:'sofa-bed',position:[r.cx-1.3,r.cz+1.0],rotation:0,props:{mode:'bed'}}, {id:'g-dc1',defId:'display-cabinet',position:[r.cx+1.2,r.cz-1.0],rotation:0,props:{style:'full-glass',lit:'yes'}}, {id:'g-dc2',defId:'display-cabinet',position:[r.cx+2.1,r.cz-1.0],rotation:0,props:{style:'half'}} ]; window.__store.getState().setItems(items); })()" },
    { "name": "wait-grid", "wait": 1600 },
    { "name": "frame-grid", "eval": "(function(){ const r = window.__room; window.__store.getState().requestFrameSelection?.({center:[r.cx, 0.9, r.cz], radius:4.6}); })()" },
    { "name": "wait-frame-grid", "wait": 2000 },
    { "name": "shot-00-grid-wide", "screenshot": "00-grid-wide" },

    { "name": "place-sofa", "eval": "(function(){ const r=window.__room; window.__store.getState().setItems([{id:'it',defId:'sofa-bed',position:[r.cx,r.cz],rotation:0.4,props:{mode:'sofa',storage:'yes',color:'#6f7a82'}}]); })()" },
    { "name": "w1", "wait": 1000 },
    { "name": "frame-sofa", "eval": "(function(){ const r=window.__room; window.__store.getState().requestFrameSelection?.({center:[r.cx,0.45,r.cz],radius:1.6}); })()" },
    { "name": "w1b", "wait": 1800 },
    { "name": "shot-01-sofabed-sofa-wide", "screenshot": "01-sofabed-sofa-wide" },
    { "name": "frame-sofa-profile", "eval": "(function(){ const r=window.__room; window.__store.getState().requestFrameSelection?.({center:[r.cx+0.2,0.4,r.cz+0.5],radius:1.0}); })()" },
    { "name": "w1c", "wait": 1800 },
    { "name": "shot-02-sofabed-sofa-profile-drawer", "screenshot": "02-sofabed-sofa-profile-drawer" },

    { "name": "place-bed", "eval": "(function(){ const r=window.__room; window.__store.getState().setItems([{id:'it',defId:'sofa-bed',position:[r.cx,r.cz],rotation:0.4,props:{mode:'bed',storage:'yes',color:'#6f7a82'}}]); })()" },
    { "name": "w2", "wait": 1000 },
    { "name": "frame-bed", "eval": "(function(){ const r=window.__room; window.__store.getState().requestFrameSelection?.({center:[r.cx,0.4,r.cz],radius:1.8}); })()" },
    { "name": "w2b", "wait": 1800 },
    { "name": "shot-03-sofabed-bed-wide", "screenshot": "03-sofabed-bed-wide" },
    { "name": "frame-bed-seam", "eval": "(function(){ const r=window.__room; window.__store.getState().requestFrameSelection?.({center:[r.cx,0.5,r.cz],radius:0.85}); })()" },
    { "name": "w2c", "wait": 1800 },
    { "name": "shot-04-sofabed-bed-fold-seam", "screenshot": "04-sofabed-bed-fold-seam" },

    { "name": "place-dc-full", "eval": "(function(){ const r=window.__room; window.__store.getState().setItems([{id:'it',defId:'display-cabinet',position:[r.cx,r.cz],rotation:0.4,props:{style:'full-glass',lit:'no'}}]); })()" },
    { "name": "w3", "wait": 1000 },
    { "name": "frame-dc-full", "eval": "(function(){ const r=window.__room; window.__store.getState().requestFrameSelection?.({center:[r.cx,0.95,r.cz],radius:1.5}); })()" },
    { "name": "w3b", "wait": 1800 },
    { "name": "shot-05-cabinet-full-glass", "screenshot": "05-cabinet-full-glass" },

    { "name": "place-dc-half", "eval": "(function(){ const r=window.__room; window.__store.getState().setItems([{id:'it',defId:'display-cabinet',position:[r.cx,r.cz],rotation:0.4,props:{style:'half',lit:'no'}}]); })()" },
    { "name": "w4", "wait": 1000 },
    { "name": "frame-dc-half", "eval": "(function(){ const r=window.__room; window.__store.getState().requestFrameSelection?.({center:[r.cx,0.9,r.cz],radius:1.5}); })()" },
    { "name": "w4b", "wait": 1800 },
    { "name": "shot-06-cabinet-half-base", "screenshot": "06-cabinet-half-base" },

    { "name": "place-dc-wall", "eval": "(function(){ const r=window.__room; window.__store.getState().setItems([{id:'it',defId:'display-cabinet',position:[r.cx,r.cz],rotation:0.4,props:{style:'wall',lit:'no'}}]); })()" },
    { "name": "w5", "wait": 1000 },
    { "name": "frame-dc-wall", "eval": "(function(){ const r=window.__room; window.__store.getState().requestFrameSelection?.({center:[r.cx,1.55,r.cz],radius:1.1}); })()" },
    { "name": "w5b", "wait": 1800 },
    { "name": "shot-07-cabinet-wall-mounted", "screenshot": "07-cabinet-wall-mounted" },

    { "name": "set-night", "eval": "(function(){ const s=window.__store.getState(); s.setManualHour?.(21); s.setLightsMode?.('on'); })()" },
    { "name": "place-dc-lit", "eval": "(function(){ const r=window.__room; window.__store.getState().setItems([{id:'it',defId:'display-cabinet',position:[r.cx,r.cz],rotation:0.4,props:{style:'full-glass',lit:'yes'}}]); })()" },
    { "name": "w6", "wait": 1200 },
    { "name": "frame-dc-lit", "eval": "(function(){ const r=window.__room; window.__store.getState().requestFrameSelection?.({center:[r.cx,0.95,r.cz],radius:1.5}); })()" },
    { "name": "w6b", "wait": 2000 },
    { "name": "shot-08-cabinet-lit-night", "screenshot": "08-cabinet-lit-night" }
  ]
}
