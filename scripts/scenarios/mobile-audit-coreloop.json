{
  "name": "mobile-audit-coreloop",
  "description": "Mobile-depth audit: home + toolbar, catalog bottom-sheet browse/search, placeConfirm, inspector sheet (transform/props/finish), FinishPicker + paint visualizer, lighting moods, share. Touch-target sweeps interleaved.",
  "url": "http://localhost:5211/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "dismiss-overlays", "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; (function(){ const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.(); s.setManualHour?.(13); })()" },
    { "name": "mobile", "viewport": { "width": 390, "height": 844 } },
    { "name": "settle-mobile", "wait": 1000 },
    { "name": "shot-home", "screenshot": "01-home-toolbar" },
    { "name": "sweep-home", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-home", "screenshot": "02-sweep-home" },
    { "name": "clear-overlay-1", "eval": "document.getElementById('__tt_overlay')?.remove()" },

    { "name": "open-menu", "eval": "(() => { const b=[...document.querySelectorAll('button')].find(x=>(x.className||'').includes('m-menu-btn')); if(b) b.click(); return !!b })()" },
    { "name": "settle-menu", "wait": 700 },
    { "name": "shot-menu", "screenshot": "03-mobile-menu-accordion" },
    { "name": "close-menu", "key": "Escape" },
    { "name": "settle-close-menu", "wait": 400 },

    { "name": "enter-room", "store": { "action": "enterRoomEditor", "args": ["livingDining"] } },
    { "name": "settle-enter", "wait": 1500 },
    { "name": "shot-room", "screenshot": "04-room-editor" },
    { "name": "open-catalog", "store": { "action": "setCatalogOpen", "args": [true] } },
    { "name": "catalog-visible", "waitFor": { "css": ".panel.catalog, .catalog" }, "timeout": 8000 },
    { "name": "settle-catalog", "wait": 1200 },
    { "name": "shot-catalog", "screenshot": "05-catalog-sheet" },
    { "name": "sweep-catalog", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-catalog", "screenshot": "06-sweep-catalog" },
    { "name": "clear-overlay-2", "eval": "document.getElementById('__tt_overlay')?.remove()" },

    { "name": "search-catalog", "eval": "(() => { const i=document.querySelector('.panel.catalog input, .catalog input[type=search], .catalog input'); if(i){ i.focus(); i.value='sofa'; i.dispatchEvent(new Event('input',{bubbles:true})); } return !!i })()" },
    { "name": "settle-search", "wait": 1000 },
    { "name": "shot-search", "screenshot": "07-catalog-search" },

    { "name": "arm-place", "eval": "(() => { const s=window.__store.getState(); s.setCatalogOpen(false); s.setActiveDefId('sofa-3seat'); s.setPlaceConfirm(true); })()" },
    { "name": "settle-arm", "wait": 1000 },
    { "name": "shot-placeconfirm", "screenshot": "08-place-confirm" },
    { "name": "sweep-place", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-place", "screenshot": "09-sweep-place-confirm" },
    { "name": "clear-overlay-3", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "cancel-place", "eval": "(() => { const s=window.__store.getState(); s.setActiveDefId(null); s.setPlaceConfirm(false); })()" },

    { "name": "select-item", "eval": "(() => { const s=window.__store.getState(); const it=s.items.find(i=>true); if(it) s.selectItem(it.id); return it?.id })()" },
    { "name": "settle-select", "wait": 1000 },
    { "name": "shot-inspector", "screenshot": "10-inspector-sheet" },
    { "name": "sweep-inspector", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-inspector", "screenshot": "11-sweep-inspector" },
    { "name": "clear-overlay-4", "eval": "document.getElementById('__tt_overlay')?.remove()" },

    { "name": "deselect", "eval": "window.__store.getState().selectItem(null)" },
    { "name": "settle-deselect", "wait": 500 },
    { "name": "open-finish", "eval": "(() => { const s=window.__store.getState(); s.selectRoom?.('livingDining'); return true })()" },
    { "name": "settle-finish", "wait": 1200 },
    { "name": "shot-finish", "screenshot": "12-finish-picker" },
    { "name": "sweep-finish", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-finish", "screenshot": "13-sweep-finish" },
    { "name": "clear-overlay-5", "eval": "document.getElementById('__tt_overlay')?.remove()" },

    { "name": "open-paintviz", "eval": "(() => { const b=[...document.querySelectorAll('button')].find(x=>/paint|visuali[sz]e|preview/i.test((x.textContent||'')+ (x.getAttribute('aria-label')||''))); if(b){ b.click(); return b.textContent||b.getAttribute('aria-label') } return 'NOT-FOUND' })()" },
    { "name": "settle-paintviz", "wait": 1500 },
    { "name": "shot-paintviz", "screenshot": "14-paint-visualizer" },
    { "name": "close-paintviz", "key": "Escape" },
    { "name": "settle-close-pv", "wait": 500 },

    { "name": "exit-room", "eval": "(() => { const s=window.__store.getState(); s.selectItem(null); s.exitRoomEditor?.(); })()" },
    { "name": "settle-exit", "wait": 1000 },
    { "name": "open-menu-2", "eval": "(() => { const b=[...document.querySelectorAll('button')].find(x=>(x.className||'').includes('m-menu-btn')); if(b) b.click(); return !!b })()" },
    { "name": "settle-menu-2", "wait": 700 },
    { "name": "open-scene-section", "eval": "(() => { const b=[...document.querySelectorAll('button, [role=button]')].find(x=>x.textContent.trim()==='Scene'); if(b) b.click(); return !!b })()" },
    { "name": "settle-scene", "wait": 900 },
    { "name": "shot-scene-moods", "screenshot": "15-scene-moods" },
    { "name": "sweep-scene", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-scene", "screenshot": "16-sweep-scene" },
    { "name": "clear-overlay-6", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "close-menu-2", "key": "Escape" },
    { "name": "settle-close-2", "wait": 400 },

    { "name": "open-share", "store": { "action": "setShareOpen", "args": [true] } },
    { "name": "share-visible", "waitFor": { "css": ".modal-overlay" }, "timeout": 8000 },
    { "name": "settle-share", "wait": 1000 },
    { "name": "shot-share", "screenshot": "17-share-modal" },
    { "name": "sweep-share", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-share", "screenshot": "18-sweep-share" }
  ]
}
