    { "name": "dismiss-overlays", "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.()" },
    { "name": "daytime", "eval": "window.__store.getState().setManualHour?.(13)" },
    { "name": "helpers", "eval": "window.__P=[10.0,3.6]; window.__scene=(items)=>window.__store.getState().setItems(items); window.__prop=(defId,props)=>[{id:'AUD',defId,position:window.__P,rotation:0,props:props||{}}]; window.__cam=(px,py,pz,tx,ty,tz)=>{const t=window.__three;if(!t)return;const c=t.controls;t.camera.position.set(px,py,pz);if(c){c.target.set(tx,ty,tz);c.update();}t.camera.lookAt(tx,ty,tz);}; true" },
    { "name": "warmup", "eval": "window.__scene(window.__prop('aquarium',{}))" },
    { "name": "wait-mount", "wait": 6000 },

    { "name": "p-aq", "eval": "window.__scene(window.__prop('aquarium',{})); window.__cam(11.0,1.05,4.9,10.0,0.85,3.6)" },
    { "name": "w-aq", "wait": 1400 },
