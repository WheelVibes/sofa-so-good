    { "name": "p-aq2", "eval": "window.__cam(10.2,1.35,5.0,10.0,0.85,3.6)" },
    { "name": "w-aq2", "wait": 1200 },
    { "name": "s-aq2", "screenshot": "aquarium-front" },

    { "name": "p-ven", "eval": "window.__scene(window.__prop('roller-blind',{kind:'venetian'})); window.__cam(10.8,0.9,5.2,10.0,1.1,3.6)" },
    { "name": "w-ven", "wait": 1300 },
    { "name": "s-ven", "screenshot": "venetian-bottom" },

    { "name": "p-piano", "eval": "window.__scene(window.__prop('piano',{})); window.__cam(11.3,0.95,5.2,10.0,0.7,3.6)" },
    { "name": "w-piano", "wait": 1300 },
    { "name": "s-piano", "screenshot": "piano-gpu" },

    { "name": "p-fp", "eval": "window.__scene(window.__prop('fireplace',{style:'console'})); window.__cam(11.0,0.85,5.0,10.0,0.5,3.6)" },
    { "name": "w-fp", "wait": 1300 },
    { "name": "s-fp", "screenshot": "fireplace-console-gpu" }
  ]
