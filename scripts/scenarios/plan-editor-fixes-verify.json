{
  "name": "plan-editor-fixes-verify",
  "url": "http://localhost:5173/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "dismiss-overlays", "eval": "(() => { const s=window.__store.getState(); localStorage.setItem('hdb_onboarded','1'); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.(); })()" },
    { "name": "pro-mode", "store": { "action": "setUiMode", "args": ["pro"] } },
    { "name": "reresolve-flags", "eval": "window.__store.getState().reresolveFeatureFlags()" },
    { "name": "open-plan", "store": { "action": "setFloorPlanEditing", "args": [true] } },
    { "name": "plan-screen", "waitFor": { "css": ".plan-screen" }, "timeout": 20000 },
    { "name": "shot-default", "screenshot": "01-default" },

    { "name": "stray-wall", "eval": "window.__store.getState().addWall({ start: [16, 1], end: [16, 3], thickness: 'internal' })" },
    { "name": "stray-room", "eval": "window.__store.getState().addRoom({ name: 'Shed', origin: [16, 6], width: 2, depth: 2 })" },
    { "name": "forked", "waitFor": { "store": "state.floorPlan.id !== 'default-hdb-4room'" } },
    { "name": "shot-strays", "screenshot": "02-stray-flags" },

    { "name": "skeleton-on", "eval": "[...document.querySelectorAll('button')].find(b=>b.textContent.trim()==='Skeleton')?.click()" },
    { "name": "shot-skeleton", "screenshot": "03-skeleton" },
    { "name": "skeleton-off", "eval": "[...document.querySelectorAll('button')].find(b=>b.textContent.trim()==='Skeleton')?.click()" },

    { "name": "select-wall", "eval": "(() => { const s=window.__store.getState(); const w=s.floorPlan.walls.find(x=>x.thickness==='external')||s.floorPlan.walls[0]; s.setPlanSelection({ type:'wall', id:w.id }); })()" },
    { "name": "shot-rotation-ring", "screenshot": "04-rotation-ring" }
  ]
}
