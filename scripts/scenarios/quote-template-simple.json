{
  "name": "quote-template",
  "steps": [
    { "name": "load", "wait": 2000 },
    { "name": "screenshot-simple-initial", "screenshot": true },
    {
      "name": "pro-mode",
      "store": { "action": "setUiMode", "args": ["pro"] }
    },
    { "name": "wait-flags", "wait": 500 },
    {
      "name": "check-flags",
      "eval": "const s=window.__store.getState(); console.log('uiMode:', s.uiMode, 'quoteTemplate:', s.flags?.quoteTemplate)"
    },
    {
      "name": "open-modal",
      "eval": "window.__store.getState().setQuoteTemplateOpen(true)"
    },
    { "name": "wait-modal", "wait": 800 },
    { "name": "screenshot-modal-open", "screenshot": true },
    {
      "name": "fill-company",
      "eval": "window.__store.getState().setQuoteTemplate({ ...window.__store.getState().quoteTemplate, companyName: 'Sofa So Good Pte Ltd', contactLine: 'design@sofasogood.sg | +65 9876 5432', headerNote: 'Valid for 30 days from issue date', gstPercent: 9, markupPercent: 15 })"
    },
    { "name": "wait-fill", "wait": 500 },
    { "name": "screenshot-modal-filled", "screenshot": true },
    {
      "name": "check-pricerules-flag",
      "eval": "console.log('priceRules flag:', window.__store.getState().flags?.priceRules, 'default carpentry:', window.__store.getState().priceRules.carpentryPerM)"
    },
    {
      "name": "edit-rates",
      "eval": "window.__store.getState().setPriceRules({ ...window.__store.getState().priceRules, floor: { ...window.__store.getState().priceRules.floor, wood: 165, stone: 180 }, carpentryPerM: 420 })"
    },
    { "name": "wait-rates", "wait": 500 },
    { "name": "screenshot-modal-rates", "screenshot": true },
    {
      "name": "verify-rate-undo",
      "eval": "const before=window.__store.getState().priceRules.carpentryPerM; window.__store.getState().undo(); console.log('carpentry after edit then undo:', before, '->', window.__store.getState().priceRules.carpentryPerM)"
    },
    {
      "name": "verify-undo-stack",
      "eval": "console.log('undo stack length:', window.__store.getState().past.length)"
    },
    {
      "name": "close-modal",
      "eval": "window.__store.getState().setQuoteTemplateOpen(false)"
    },
    { "name": "screenshot-closed", "screenshot": true }
  ]
}
