    {
      "name": "orbit-slow-rotate",
      "mode": "orbit",
      "arms": [
        "desktop-metal",
        "desktop-swiftshader"
      ],
      "note": "slow full rotation, one continuous drag",
      "ops": [
        {
          "op": "drag",
          "from": [
            340,
            470
          ],
          "to": [
            980,
            470
          ],
          "steps": 60,
          "stepMs": 45
        },
        {
          "op": "wait",
          "ms": 1200
        }
      ]
    },
