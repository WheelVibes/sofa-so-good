    {
      "name": "orbit-hour-ramp-mid-drag",
      "mode": "orbit",
      "arms": [
        "desktop-metal",
        "desktop-swiftshader"
      ],
      "note": "time-of-day scrub 6h->20h WHILE the rotate gesture is held",
      "setup": [
        {
          "op": "store",
          "fn": "setManualHour",
          "args": [
            6
          ]
        }
      ],
      "ops": [
        {
          "op": "parallel",
          "ops": [
            {
              "op": "drag",
              "from": [
                760,
                470
              ],
              "to": [
                440,
                470
              ],
              "steps": 40,
              "stepMs": 70
            },
            {
              "op": "ramp",
              "fn": "setManualHour",
              "from": 6,
              "to": 20,
              "steps": 16,
              "stepMs": 170
            }
          ]
        },
        {
          "op": "wait",
          "ms": 900
        }
      ]
    },
    {
      "name": "orbit-tier-change-mid-drag",
      "mode": "orbit",
      "arms": [
        "desktop-metal",
        "desktop-swiftshader"
      ],
      "note": "quality tier realistic->performance->realistic mid-gesture",
      "ops": [
        {
          "op": "parallel",
          "ops": [
            {
              "op": "drag",
              "from": [
                740,
                470
              ],
              "to": [
                460,
                470
              ],
              "steps": 34,
              "stepMs": 70
            },
            {
              "op": "eval",
              "js": "(async () => { const s = window.__store.getState(); await new Promise(r=>setTimeout(r,800)); s.setQualityTier('performance'); await new Promise(r=>setTimeout(r,1200)); s.setQualityTier('realistic') })()"
            }
          ]
        },
        {
          "op": "wait",
          "ms": 1400
        }
      ]
    },
