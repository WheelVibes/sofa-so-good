{
  "name": "skyline-backdrop-simple",
  "url": "http://localhost:5208/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    {
      "name": "dismiss-overlays",
      "eval": "(() => { const s = window.__store.getState(); localStorage.setItem('hdb_onboarded','1'); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.(); s.setManualHour?.(13); })()"
    },
    { "name": "settle", "wait": 1500 },
    { "name": "shot-city-default", "screenshot": "city-default" },
    {
      "name": "assert-photoBackdrop-flag-on",
      "waitFor": { "store": "state.featureFlags.photoBackdrop === true" }
    },
    { "name": "set-skyline", "store": { "action": "setBackdrop", "args": ["skyline"] } },
    { "name": "settle-skyline", "wait": 1500 },
    { "name": "shot-skyline", "screenshot": "skyline" },
    {
      "name": "tilt-to-horizon",
      "drag": { "from": [800, 520], "to": [800, 240] }
    },
    { "name": "settle-tilt", "wait": 1200 },
    { "name": "shot-skyline-horizon", "screenshot": "skyline-horizon" },
    { "name": "back-to-city", "store": { "action": "setBackdrop", "args": ["city"] } },
    { "name": "settle-back", "wait": 1500 },
    { "name": "shot-city-again", "screenshot": "city-again" }
  ]
}
