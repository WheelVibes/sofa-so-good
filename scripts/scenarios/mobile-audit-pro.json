{
  "name": "mobile-audit-pro",
  "description": "Mobile-depth audit of Pro analytical surfaces at 390x844: Clearance checks (+ floor loading), Design score, Reno rules, Handover/DLP (date + checklist), Drawings/elevation set. Touch sweeps interleaved.",
  "url": "http://localhost:5211/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "boot-splash-gone", "waitFor": { "css": "#boot-loader", "visible": false }, "timeout": 60000, "failMessage": "#boot-loader still covering the screen. It is removed from the DOM only once `booting` clears, which depends on sceneReady \u2014 measured 751ms and 36604ms across two runs of the SAME scenario, so no fixed wait covers it. Every screenshot before this point is the loader, and nothing fails (v0.31.9.6)." },
    { "name": "dismiss-overlays", "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; (function(){ const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.(); s.setManualHour?.(13); s.setUiMode?.('pro'); s.reresolveFeatureFlags?.(); })()" },
    { "name": "mobile", "viewport": { "width": 390, "height": 844 } },
    { "name": "settle-mobile", "wait": 800 },

    { "name": "open-checks", "store": { "action": "setClearancePanelOpen", "args": [true] } },
    { "name": "checks-visible", "waitFor": { "css": ".clr-stat, .panel" }, "timeout": 20000 },
    { "name": "settle-checks", "wait": 1500 },
    { "name": "shot-checks", "screenshot": "30-checks" },
    { "name": "sweep-checks", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-checks", "screenshot": "31-sweep-checks" },
    { "name": "clear-ov-checks", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "scroll-checks", "eval": "(function(){ const b=document.querySelector('.panel .panel-body, .panel'); if(b) b.scrollTop=b.scrollHeight; })()" },
    { "name": "settle-scroll-checks", "wait": 800 },
    { "name": "shot-checks-floorload", "screenshot": "32-checks-floor-loading" },
    { "name": "close-checks", "store": { "action": "setClearancePanelOpen", "args": [false] } },
    { "name": "settle-close-checks", "wait": 500 },

    { "name": "open-score", "store": { "action": "setDesignScoreOpen", "args": [true] } },
    { "name": "score-visible", "waitFor": { "css": ".panel" }, "timeout": 20000 },
    { "name": "settle-score", "wait": 1500 },
    { "name": "shot-score", "screenshot": "33-design-score" },
    { "name": "sweep-score", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-score", "screenshot": "34-sweep-score" },
    { "name": "clear-ov-score", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "close-score", "store": { "action": "setDesignScoreOpen", "args": [false] } },
    { "name": "settle-close-score", "wait": 500 },

    { "name": "open-reno", "store": { "action": "setRenoRulesOpen", "args": [true] } },
    { "name": "settle-reno", "wait": 3000 },
    { "name": "shot-reno", "screenshot": "35-reno-rules" },
    { "name": "sweep-reno", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-reno", "screenshot": "36-sweep-reno" },
    { "name": "clear-ov-reno", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "close-reno", "store": { "action": "setRenoRulesOpen", "args": [false] } },
    { "name": "settle-close-reno", "wait": 500 },

    { "name": "open-handover", "store": { "action": "setHandoverOpen", "args": [true] } },
    { "name": "settle-handover", "wait": 3500 },
    { "name": "shot-handover", "screenshot": "37-handover-dlp" },
    { "name": "sweep-handover", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-handover", "screenshot": "38-sweep-handover" },
    { "name": "clear-ov-handover", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "scroll-handover", "eval": "(function(){ const b=document.querySelector('.panel .panel-body, .modal-overlay .panel-body, .panel'); if(b) b.scrollTop=600; })()" },
    { "name": "settle-scroll-ho", "wait": 700 },
    { "name": "shot-handover-checklist", "screenshot": "39-handover-checklist" },
    { "name": "close-handover", "store": { "action": "setHandoverOpen", "args": [false] } },
    { "name": "settle-close-ho", "wait": 500 },

    { "name": "open-drawings", "store": { "action": "setElevationsOpen", "args": [true] } },
    { "name": "settle-drawings", "wait": 3000 },
    { "name": "shot-drawings", "screenshot": "40-drawings" },
    { "name": "sweep-drawings", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-drawings", "screenshot": "41-sweep-drawings" }
  ]
}
