{
  "name": "shared-library-journey",
  "url": "http://localhost:5173/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    {
      "name": "dismiss-overlays",
      "eval": "const s = window.__store.getState(); localStorage.setItem('hdb_onboarded','1'); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.()"
    },
    {
      "name": "sign-in-admin",
      "eval": "window.__store.getState().signIn({ username: 'admin@sofa.dev', password: 'Admin@sofa.dev123!' })"
    },
    {
      "name": "await-admin-session",
      "waitFor": {
        "store": "window.__store.getState().currentUser && window.__store.getState().currentUser.role === 'admin'"
      },
      "timeout": 20000
    },
    {
      "name": "bootstrap-shared-library",
      "eval": "window.__store.getState().bootstrapSharedLibrary()"
    },
    {
      "name": "await-index-populated",
      "waitFor": {
        "store": "window.__store.getState().sharedLibrary.status === 'ready' && window.__store.getState().sharedLibrary.items.length > 0"
      },
      "timeout": 30000,
      "failMessage": "sharedLibrary should populate from the local R2 mirror (/api/assets/library/index.json)"
    },
    {
      "name": "import-first-group",
      "eval": "const it = window.__store.getState().sharedLibrary.items[0]; window.__importedKey = 'ikea-' + it.groupKey; window.__store.getState().addSharedGroup(it.group)"
    },
    {
      "name": "await-group-imported",
      "waitFor": {
        "store": "window.__store.getState().userFurniture.some((d) => d.id === window.__importedKey)"
      },
      "timeout": 40000,
      "failMessage": "addSharedGroup should fetch the group's metadata + GLB from the local mirror and register it into userFurniture"
    },
    { "name": "settle", "wait": 400 },
    { "name": "shot-scene", "screenshot": "shared-library-imported" }
  ]
}
