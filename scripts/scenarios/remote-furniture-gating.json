{
  "name": "remote-furniture-gating",
  "url": "http://localhost:5173/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "boot-splash-gone", "waitFor": { "css": "#boot-loader", "visible": false }, "timeout": 60000, "failMessage": "#boot-loader still covering the screen. It is removed from the DOM only once `booting` clears, which depends on sceneReady \u2014 measured 751ms and 36604ms across two runs of the SAME scenario, so no fixed wait covers it. Every screenshot before this point is the loader, and nothing fails (v0.31.9.6)." },
    {
      "name": "dismiss-overlays",
      "eval": "(()=>{const s=window.__store.getState();s.endTour?.();s.setOnboardingOpen?.(false);s.dismissLocationPrompt?.();localStorage.setItem('hdb_onboarded','1')})()"
    },
    {
      "name": "inject-remote-entry",
      "eval": "(()=>{const s=window.__store.getState();const sofa={provider:'polyhaven',slug:'cozy_sofa',kind:'furniture',name:'Cozy CC0 Sofa',category:'seating',thumbUrl:'',resolutions:['2k'],attribution:'Poly Haven',sourceUrl:'https://polyhaven.com/a/cozy_sofa'};window.__store.setState((st)=>({remoteIndexes:{...st.remoteIndexes,polyhaven:{status:'ready',entries:[sofa]}}}))})()"
    },
    {
      "name": "enter-room-editor",
      "eval": "(()=>{const s=window.__store.getState();s.enterRoomEditor?.('livingDining');s.setCatalogOpen?.(true)})()"
    },
    { "name": "to-pro", "store": { "action": "setUiMode", "args": ["pro"] } },
    { "name": "catalog-mounted-pro", "waitFor": { "css": ".panel.catalog" }, "timeout": 20000 },
    {
      "name": "select-seating-pro",
      "eval": "(()=>{const btns=[...document.querySelectorAll('.panel.catalog .cat-tab, .panel.catalog button')];const b=btns.find(x=>/seating/i.test(x.textContent||''));b&&b.click()})()"
    },
    { "name": "settle-pro", "wait": 800 },
    { "name": "shot-pro", "screenshot": "catalog-pro" },
    {
      "name": "probe-pro",
      "eval": "(()=>{const cards=[...document.querySelectorAll('.panel.catalog .cat-card')];const hasRemote=cards.some(c=>/Cozy CC0 Sofa/.test(c.textContent||''));const hasCC0=[...document.querySelectorAll('.panel.catalog .badge')].some(b=>/CC0/.test(b.textContent||''));console.log('PROBE_PRO '+JSON.stringify({flag:window.__store.getState().featureFlags.remoteFurniture,hasRemote,hasCC0}))})()"
    },
    { "name": "to-simple", "store": { "action": "setUiMode", "args": ["simple"] } },
    { "name": "settle-simple", "wait": 800 },
    {
      "name": "reopen-catalog-simple",
      "eval": "(()=>{const s=window.__store.getState();s.setCatalogOpen?.(true)})()"
    },
    { "name": "catalog-mounted-simple", "waitFor": { "css": ".panel.catalog" }, "timeout": 20000 },
    {
      "name": "select-seating-simple",
      "eval": "(()=>{const btns=[...document.querySelectorAll('.panel.catalog .cat-tab, .panel.catalog button')];const b=btns.find(x=>/seating/i.test(x.textContent||''));b&&b.click()})()"
    },
    { "name": "settle-simple2", "wait": 800 },
    { "name": "shot-simple", "screenshot": "catalog-simple" },
    {
      "name": "probe-simple",
      "eval": "(()=>{const cards=[...document.querySelectorAll('.panel.catalog .cat-card')];const hasRemote=cards.some(c=>/Cozy CC0 Sofa/.test(c.textContent||''));const hasCC0=[...document.querySelectorAll('.panel.catalog .badge')].some(b=>/CC0/.test(b.textContent||''));console.log('PROBE_SIMPLE '+JSON.stringify({flag:window.__store.getState().featureFlags.remoteFurniture,hasRemote,hasCC0}))})()"
    }
  ]
}
