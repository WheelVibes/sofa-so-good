{ "name":"plan-multiselect-transform","url":"http://localhost:5173/","steps":[
  { "name":"r","waitFor":{"storeExists":true},"timeout":60000 },
  { "name":"viewport","viewport":{"width":420,"height":900,"isMobile":true} },
  { "name":"d","eval":"(()=>{const s=window.__store.getState();localStorage.setItem('hdb_onboarded','1');s.endTour?.();s.setOnboardingOpen?.(false);s.dismissLocationPrompt?.();s.setUiMode('pro');s.reresolveFeatureFlags();s.setFloorPlanEditing(true);s.setGridSize&&s.setGridSize(0.05);})()" },
  { "name":"w","waitFor":{"css":".plan-screen"},"timeout":30000 },
  { "name":"settle","wait":1200 },
  { "name":"menu","type":"click","text":"☰ Menu" },
  { "name":"wmenu","wait":500 },
  { "name":"furniture","type":"click","text":"Furniture" },
  { "name":"esc","type":"key","key":"Escape" },
  { "name":"edit","type":"click","text":"Edit" },
  { "name":"wedit","wait":300 },
  { "name":"select2","eval":"(()=>{const s=window.__store.getState();const g=s.items.filter(i=>!i.levelId).slice(0,2);s.setSelectedItemIds(g.map(i=>i.id));window.__a=g[0].id;window.__b=g[1].id;const el=document.querySelector('[data-item-id=\"'+g[0].id+'\"]');const r=el.getBoundingClientRect();window.__x0=r.x+r.width/2;window.__y0=r.y+r.height/2;})()" },
  { "name":"wsel","wait":300 },
  { "name":"dn","eval":"(()=>{document.querySelector('[data-item-id=\"'+window.__a+'\"]').dispatchEvent(new PointerEvent('pointerdown',{clientX:window.__x0,clientY:window.__y0,bubbles:true,pointerId:1,button:0}));})()" },
  { "name":"w1","wait":140 },
  { "name":"mv","eval":"(()=>{document.querySelector('.plan-paper').dispatchEvent(new PointerEvent('pointermove',{clientX:window.__x0,clientY:window.__y0+260,bubbles:true,pointerId:1}));})()" },
  { "name":"w2","wait":140 },
  { "name":"upp","eval":"(()=>{document.querySelector('.plan-paper').dispatchEvent(new PointerEvent('pointerup',{clientX:window.__x0,clientY:window.__y0+260,bubbles:true,pointerId:1}));})()" },
  { "name":"w3","wait":400 },
  { "name":"recordrot","eval":"(()=>{const s=window.__store.getState();window.__ra=s.items.find(i=>i.id===window.__a).rotation;window.__rb=s.items.find(i=>i.id===window.__b).rotation;console.log('movedDown='+(+(s.items.find(i=>i.id===window.__a).position[1]).toFixed(1)));})()" },
  { "name":"kdn","eval":"(()=>{const knob=[...document.querySelectorAll('circle')].find(c=>+c.getAttribute('r')===7);const r=knob.getBoundingClientRect();window.__kx=r.x+r.width/2;window.__ky=r.y+r.height/2;knob.dispatchEvent(new PointerEvent('pointerdown',{clientX:window.__kx,clientY:window.__ky,bubbles:true,pointerId:1,button:0}));console.log('KNOB '+Math.round(window.__kx)+','+Math.round(window.__ky));})()" },
  { "name":"k1","wait":140 },
  { "name":"kmv","eval":"(()=>{document.querySelector('.plan-paper').dispatchEvent(new PointerEvent('pointermove',{clientX:window.__kx+70,clientY:window.__ky+50,bubbles:true,pointerId:1}));})()" },
  { "name":"k2","wait":140 },
  { "name":"kmv2","eval":"(()=>{document.querySelector('.plan-paper').dispatchEvent(new PointerEvent('pointermove',{clientX:window.__kx+110,clientY:window.__ky+110,bubbles:true,pointerId:1}));})()" },
  { "name":"k3","wait":140 },
  { "name":"kup","eval":"(()=>{document.querySelector('.plan-paper').dispatchEvent(new PointerEvent('pointerup',{clientX:window.__kx+110,clientY:window.__ky+110,bubbles:true,pointerId:1}));})()" },
  { "name":"k4","wait":300 },
  { "name":"probe","eval":"(()=>{const s=window.__store.getState();const dra=+(s.items.find(i=>i.id===window.__a).rotation-window.__ra).toFixed(4);const drb=+(s.items.find(i=>i.id===window.__b).rotation-window.__rb).toFixed(4);console.log('PROBE dRotA='+dra+' dRotB='+drb+' equal='+(dra===drb)+' rotated='+(Math.abs(dra)>0.001));})()" }
]}
