{
  "name": "snv-specs-verify",
  "url": "http://localhost:5173/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "boot-splash-gone", "waitFor": { "css": "#boot-loader", "visible": false }, "timeout": 60000, "failMessage": "#boot-loader still covering the screen. It is removed from the DOM only once `booting` clears, which depends on sceneReady \u2014 measured 751ms and 36604ms across two runs of the SAME scenario, so no fixed wait covers it. Every screenshot before this point is the loader, and nothing fails (v0.31.9.6)." },
    { "name": "perf-tier", "eval": "window.__store.getState().setQualityTier('performance')" },
    { "name": "midday", "eval": "window.__store.getState().setManualHour(13)" },
    { "name": "settle-boot", "wait": 9000 },
    { "name": "shot-overview", "screenshot": "01-overview-floors" },
    { "name": "room-bath1", "eval": "window.__store.getState().enterRoomEditor('bath1')" },
    { "name": "settle-bath1", "wait": 6000 },
    { "name": "shot-bath1", "screenshot": "02-bath1-fittings-tiles" },
    { "name": "room-bath2", "eval": "window.__store.getState().enterRoomEditor('bath2')" },
    { "name": "settle-bath2", "wait": 5000 },
    { "name": "shot-bath2", "screenshot": "03-bath2-fittings-tiles" },
    { "name": "room-mb", "eval": "window.__store.getState().enterRoomEditor('mainBedroom')" },
    { "name": "settle-mb", "wait": 5000 },
    { "name": "shot-mb", "screenshot": "04-mainbedroom-grille-vinyl" },
    { "name": "room-sy", "eval": "window.__store.getState().enterRoomEditor('serviceYard')" },
    { "name": "settle-sy", "wait": 5000 },
    { "name": "shot-sy", "screenshot": "05-service-yard" },
    { "name": "exit-room", "eval": "window.__store.getState().exitRoomEditor()" },
    { "name": "settle-exit", "wait": 2500 },
    { "name": "focus-entrance", "eval": "window.__store.getState().focusOn([11.3, 7.8])" },
    { "name": "settle-entrance", "wait": 2000 },
    { "name": "shot-entrance-closed", "screenshot": "06-entrance-gate-closed" },
    { "name": "open-main", "eval": "window.__store.getState().toggleDoor('door-main')" },
    { "name": "settle-main-open", "wait": 1200 },
    { "name": "shot-entrance-open", "screenshot": "07-entrance-gate-open" },
    { "name": "open-bath-doors", "eval": "const s=window.__store.getState(); s.toggleDoor('door-bath1'); s.toggleDoor('door-bath2')" },
    { "name": "top-view", "eval": "window.__store.getState().requestTopView()" },
    { "name": "settle-top", "wait": 2000 },
    { "name": "shot-top-bifold", "screenshot": "08-top-bifold-floors" },
    { "name": "pro-mode", "store": { "action": "setUiMode", "args": ["pro"] } },
    { "name": "reresolve-flags", "eval": "window.__store.getState().reresolveFeatureFlags()" },
    { "name": "open-plan", "store": { "action": "setFloorPlanEditing", "args": [true] } },
    { "name": "plan-screen", "waitFor": { "css": ".plan-screen" }, "timeout": 20000 },
    { "name": "settle-plan", "wait": 800 },
    { "name": "shot-plan-doors", "screenshot": "09-plan-editor-doors" }
  ]
}
