{
  "name": "ux-audit-01-coldstart",
  "description": "UX audit stage 1: fresh localStorage cold start — onboarding carousel, tour choice, location prompt, default furnished flat first paint.",
  "url": "http://localhost:5211/",
  "keepFirstRun": true,
  "steps": [
    { "name": "clear-storage", "eval": "try { localStorage.clear() } catch {}" },
    { "name": "reload-clean", "eval": "location.reload()" },
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "boot-splash-gone", "waitFor": { "css": "#boot-loader", "visible": false }, "timeout": 60000, "failMessage": "#boot-loader still covering the screen. It is removed from the DOM only once `booting` clears, which depends on sceneReady \u2014 measured 751ms and 36604ms across two runs of the SAME scenario, so no fixed wait covers it. Every screenshot before this point is the loader, and nothing fails (v0.31.9.6)." },
    { "name": "onboarding-open", "waitFor": { "store": "state.onboardingOpen === true" }, "timeout": 60000 },
    { "name": "shot-onboarding-welcome", "screenshot": "onboarding-welcome" },
    { "name": "click-get-started", "click": { "text": "Get started" } },
    { "name": "onboarding-step2-visible", "waitFor": { "css": ".onb-body2" }, "timeout": 5000 },
    { "name": "shot-onboarding-step2", "screenshot": "onboarding-step2" },
    { "name": "click-next", "click": { "text": "Next" } },
    { "name": "onboarding-step3-visible", "waitFor": { "css": ".onb-body3" }, "timeout": 5000 },
    { "name": "shot-onboarding-choices", "screenshot": "onboarding-choices" },
    { "name": "click-guided-tour", "click": { "text": "Take the guided tour" } },
    { "name": "onboarding-closed", "waitFor": { "store": "state.onboardingOpen === false" }, "timeout": 5000 },
    { "name": "tour-open", "waitFor": { "store": "state.tourOpen === true" }, "timeout": 8000 },
    { "name": "shot-tour-step1", "screenshot": "tour-step1" },
    { "name": "tour-next-1", "click": { "text": "Next" } },
    { "name": "tour-step2-wait", "waitFor": { "store": "state.tourStep === 1" }, "timeout": 5000 },
    { "name": "shot-tour-step2", "screenshot": "tour-step2" },
    { "name": "tour-next-2", "click": { "text": "Next" } },
    { "name": "tour-step3-wait", "waitFor": { "store": "state.tourStep === 2" }, "timeout": 5000 },
    { "name": "shot-tour-step3", "screenshot": "tour-step3" },
    { "name": "skip-tour", "click": { "text": "Skip tour" } },
    { "name": "tour-closed", "waitFor": { "store": "state.tourOpen === false" }, "timeout": 5000 },
    { "name": "location-prompt-visible", "waitFor": { "css": ".modal-overlay" }, "timeout": 8000 },
    { "name": "shot-location-prompt", "screenshot": "location-prompt" },
    { "name": "dismiss-location", "click": { "text": "Skip — use default location" } },
    { "name": "location-dismissed", "waitFor": { "css": ".modal-overlay", "visible": false }, "timeout": 5000 },
    { "name": "settle", "wait": 2500 },
    { "name": "shot-final-scene", "screenshot": "final-scene-first-paint" }
  ]
}
