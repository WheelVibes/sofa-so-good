{
  "name": "first-run",
  "description": "Walk the full first-user experience on a clean profile: boot → onboarding carousel (welcome → overview → choices) → choose guided tour → tour steps 1–3 (then skip) → location prompt → furnished scene.",
  "url": "http://localhost:5212/",
  "steps": [
    {
      "name": "clear-storage",
      "eval": "try { localStorage.clear() } catch {}"
    },
    {
      "name": "reload-clean",
      "eval": "location.reload()"
    },
    {
      "name": "store-ready",
      "waitFor": { "storeExists": true },
      "timeout": 60000
    },
    {
      "name": "onboarding-open",
      "waitFor": { "store": "state.onboardingOpen === true" },
      "timeout": 60000
    },
    {
      "name": "shot-onboarding-welcome",
      "screenshot": "onboarding-step1-welcome"
    },
    {
      "name": "click-get-started",
      "click": { "text": "Get started" }
    },
    {
      "name": "onboarding-step2-visible",
      "waitFor": { "css": ".onb-body2" },
      "timeout": 5000
    },
    {
      "name": "shot-onboarding-step2",
      "screenshot": "onboarding-step2-tour-overview"
    },
    {
      "name": "click-next",
      "click": { "text": "Next" }
    },
    {
      "name": "onboarding-step3-visible",
      "waitFor": { "css": ".onb-body3" },
      "timeout": 5000
    },
    {
      "name": "shot-onboarding-choices",
      "screenshot": "onboarding-step3-choices"
    },
    {
      "name": "click-guided-tour",
      "click": { "text": "Take the guided tour" }
    },
    {
      "name": "onboarding-closed",
      "waitFor": { "store": "state.onboardingOpen === false" },
      "timeout": 5000
    },
    {
      "name": "tour-open",
      "waitFor": { "store": "state.tourOpen === true" },
      "timeout": 8000
    },
    {
      "name": "shot-tour-step1",
      "screenshot": "tour-step1-welcome"
    },
    {
      "name": "tour-next-1",
      "click": { "text": "Next" }
    },
    {
      "name": "tour-step2-wait",
      "waitFor": { "store": "state.tourStep === 1" },
      "timeout": 5000
    },
    {
      "name": "shot-tour-step2",
      "screenshot": "tour-step2-look-around"
    },
    {
      "name": "tour-next-2",
      "click": { "text": "Next" }
    },
    {
      "name": "tour-step3-wait",
      "waitFor": { "store": "state.tourStep === 2" },
      "timeout": 5000
    },
    {
      "name": "shot-tour-step3",
      "screenshot": "tour-step3-enter-room"
    },
    {
      "name": "skip-tour",
      "click": { "text": "Skip tour" }
    },
    {
      "name": "tour-closed",
      "waitFor": { "store": "state.tourOpen === false" },
      "timeout": 5000
    },
    {
      "name": "location-prompt-visible",
      "waitFor": { "css": ".modal-overlay" },
      "timeout": 8000
    },
    {
      "name": "shot-location-prompt",
      "screenshot": "location-prompt"
    },
    {
      "name": "dismiss-location",
      "click": { "text": "Skip — use default location" }
    },
    {
      "name": "location-dismissed",
      "waitFor": { "css": ".modal-overlay", "visible": false },
      "timeout": 5000
    },
    {
      "name": "settle",
      "wait": 2000
    },
    {
      "name": "shot-final-scene",
      "screenshot": "final-scene"
    }
  ]
}
