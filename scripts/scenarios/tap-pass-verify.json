{
  "name": "tap-pass-verify",
  "description": "Verify the mobile tap-target pass 2 (MOB-P2-1/P2-2) + P3-1 mood label + P3-3 hackability discoverability at 390x844 with SHOT_TOUCH. Sweeps the catalog, finish picker, share, drawings, plan header and plan-tools View section.",
  "url": "http://localhost:5211/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "boot-splash-gone", "waitFor": { "css": "#boot-loader", "visible": false }, "timeout": 60000, "failMessage": "#boot-loader still covering the screen. It is removed from the DOM only once `booting` clears, which depends on sceneReady \u2014 measured 751ms and 36604ms across two runs of the SAME scenario, so no fixed wait covers it. Every screenshot before this point is the loader, and nothing fails (v0.31.9.6)." },
    { "name": "dismiss-overlays", "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; (function(){ const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.(); s.setManualHour?.(13); s.setUiMode?.('pro'); s.reresolveFeatureFlags?.(); })()" },
    { "name": "mobile", "viewport": { "width": 390, "height": 844 } },
    { "name": "settle-mobile", "wait": 1000 },

    { "name": "enter-room", "store": { "action": "enterRoomEditor", "args": ["livingDining"] } },
    { "name": "settle-enter", "wait": 1500 },
    { "name": "open-catalog", "store": { "action": "setCatalogOpen", "args": [true] } },
    { "name": "catalog-visible", "waitFor": { "css": ".panel.catalog, .catalog" }, "timeout": 8000 },
    { "name": "settle-catalog", "wait": 1200 },
    { "name": "shot-catalog", "screenshot": "01-catalog-sheet" },
    { "name": "sweep-catalog", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-catalog", "screenshot": "02-sweep-catalog" },
    { "name": "clear-1", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "close-catalog", "store": { "action": "setCatalogOpen", "args": [false] } },

    { "name": "open-finish", "eval": "(() => { const s=window.__store.getState(); s.selectRoom?.('livingDining'); return true })()" },
    { "name": "finish-visible", "waitFor": { "css": ".finish-picker" }, "timeout": 8000 },
    { "name": "settle-finish", "wait": 1200 },
    { "name": "shot-finish", "screenshot": "03-finish-picker" },
    { "name": "sweep-finish", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-finish", "screenshot": "04-sweep-finish" },
    { "name": "clear-2", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "deselect", "eval": "window.__store.getState().selectRoom?.(null)" },

    { "name": "open-menu", "eval": "(() => { const b=[...document.querySelectorAll('button')].find(x=>(x.className||'').includes('m-menu-btn')); if(b) b.click(); return !!b })()" },
    { "name": "settle-menu", "wait": 700 },
    { "name": "open-scene-section", "eval": "(() => { const b=[...document.querySelectorAll('button, [role=button]')].find(x=>x.textContent.trim()==='Scene'); if(b) b.click(); return !!b })()" },
    { "name": "settle-scene", "wait": 900 },
    { "name": "shot-scene-moods", "screenshot": "05-scene-moods" },
    { "name": "sweep-scene", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-scene", "screenshot": "06-sweep-scene" },
    { "name": "clear-3", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "close-menu", "key": "Escape" },
    { "name": "settle-close-menu", "wait": 400 },

    { "name": "exit-room", "eval": "(() => { const s=window.__store.getState(); s.selectItem(null); s.exitRoomEditor?.(); })()" },
    { "name": "settle-exit", "wait": 1000 },

    { "name": "open-share", "store": { "action": "setShareOpen", "args": [true] } },
    { "name": "share-visible", "waitFor": { "css": ".modal-overlay" }, "timeout": 8000 },
    { "name": "settle-share", "wait": 1000 },
    { "name": "shot-share", "screenshot": "07-share" },
    { "name": "sweep-share", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-share", "screenshot": "08-sweep-share" },
    { "name": "clear-4", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "close-share", "store": { "action": "setShareOpen", "args": [false] } },

    { "name": "open-drawings", "store": { "action": "setElevationsOpen", "args": [true] } },
    { "name": "drawings-visible", "waitFor": { "css": "#elevationPanel" }, "timeout": 8000 },
    { "name": "settle-drawings", "wait": 3000 },
    { "name": "shot-drawings", "screenshot": "09-drawings" },
    { "name": "sweep-drawings", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-drawings", "screenshot": "10-sweep-drawings" },
    { "name": "clear-5", "eval": "document.getElementById('__tt_overlay')?.remove()" },
    { "name": "close-drawings", "store": { "action": "setElevationsOpen", "args": [false] } },

    { "name": "open-plan", "store": { "action": "setFloorPlanEditing", "args": [true] } },
    { "name": "plan-visible", "waitFor": { "css": ".plan-screen" }, "timeout": 30000 },
    { "name": "settle-plan", "wait": 2000 },
    { "name": "enter-edit-mode", "eval": "(() => { const b=[...document.querySelectorAll('.plan-header button')].find(x=>x.textContent.trim()==='Edit'); if(b) b.click(); return !!b })()" },
    { "name": "settle-edit", "wait": 800 },
    { "name": "shot-plan", "screenshot": "11-plan-header" },
    { "name": "sweep-plan", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-plan", "screenshot": "12-sweep-plan" },
    { "name": "clear-6", "eval": "document.getElementById('__tt_overlay')?.remove()" },

    { "name": "open-plan-tools", "eval": "(() => { const b=[...document.querySelectorAll('.plan-header button')].find(x=>(x.className||'').includes('m-menu-btn')); if(b) b.click(); return !!b })()" },
    { "name": "settle-plan-tools", "wait": 800 },
    { "name": "open-view-section", "eval": "(() => { const b=[...document.querySelectorAll('[role=tab], .m-rail-btn, button')].find(x=>(x.getAttribute('title')||x.getAttribute('aria-label')||x.textContent||'').trim()==='View'); if(b) b.click(); return b?(b.title||b.textContent):'NOT-FOUND' })()" },
    { "name": "settle-view-section", "wait": 800 },
    { "name": "check-hackability", "eval": "(() => { const b=[...document.querySelectorAll('button')].find(x=>/hackab/i.test(x.textContent||'')); return b? ('FOUND: '+b.textContent.trim()) : 'NOT-FOUND' })()" },
    { "name": "shot-plan-tools-view", "screenshot": "13-plan-tools-view-hackability" },
    { "name": "sweep-plan-tools", "eval": { "file": "scripts/scenarios/lib/touchSweep.mjs" } },
    { "name": "shot-sweep-plan-tools", "screenshot": "14-sweep-plan-tools" }
  ]
}
