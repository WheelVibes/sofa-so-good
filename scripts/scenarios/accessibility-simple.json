{
  "name": "accessibility-simple",
  "description": "IXT-SUITES: accessibility check (pro). Hidden in Simple, present in Pro; the panel (#accessibilityPanel) mounts with door-width / turning-space results. Mobile bottom-sheet; back-to-Simple hides it.",
  "url": "http://localhost:5208/",
  "steps": [
    { "name": "store-ready", "waitFor": { "storeExists": true }, "timeout": 60000 },
    { "name": "dismiss-overlays", "eval": "try { localStorage.setItem('hdb_onboarded','1') } catch {}; const s = window.__store.getState(); s.endTour?.(); s.setOnboardingOpen?.(false); s.dismissLocationPrompt?.()" },
    { "name": "set-daytime", "eval": "window.__store.getState().setManualHour?.(13)" },
    { "name": "assert-simple-hidden", "waitFor": { "store": "state.uiMode === 'simple' && state.featureFlags.accessibility === false" }, "timeout": 5000, "failMessage": "accessibility should be OFF in Simple mode" },
    { "name": "to-pro", "eval": "(()=>{const s=window.__store.getState(); s.setUiMode('pro'); s.reresolveFeatureFlags();})()" },
    { "name": "assert-pro-on", "waitFor": { "store": "state.featureFlags.accessibility === true" }, "timeout": 5000, "failMessage": "accessibility should be ON in Pro mode" },
    { "name": "open-panel", "store": { "action": "setAccessibilityOpen", "args": [true] } },
    { "name": "panel-visible", "waitFor": { "css": "#accessibilityPanel" }, "timeout": 8000, "failMessage": "Accessibility panel did not mount" },
    { "name": "assert-title", "waitFor": { "text": "Accessibility" }, "timeout": 5000 },
    { "name": "shot-panel", "screenshot": "accessibility-panel" },
    { "name": "mobile", "viewport": { "width": 390, "height": 844 } },
    { "name": "settle-mobile", "wait": 1000 },
    { "name": "shot-mobile", "screenshot": "accessibility-mobile" },
    { "name": "close-panel", "store": { "action": "setAccessibilityOpen", "args": [false] } },
    { "name": "panel-gone", "waitFor": { "css": "#accessibilityPanel", "visible": false }, "timeout": 5000 },
    { "name": "back-to-simple", "eval": "(()=>{const s=window.__store.getState(); s.setUiMode('simple'); s.reresolveFeatureFlags();})()" },
    { "name": "assert-simple-again", "waitFor": { "store": "state.featureFlags.accessibility === false" }, "timeout": 5000 }
  ]
}
